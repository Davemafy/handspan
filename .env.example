# Self-hosted server settings. Never put your real production URL or token in Git.
PORT=3000
MCP_ACCESS_TOKEN=REPLACE_WITH_A_GENERATED_RANDOM_TOKEN_MIN_32_CHARS
# Exact hostnames by default, or TARGET_HOSTS=* for public-web exploration.
# Wildcard requires ENABLE_OPEN_WEB=true and a network-isolated browser runner.
TARGET_HOSTS=example.com
ENABLE_OPEN_WEB=false
RESOURCE_HOSTS=fonts.googleapis.com,fonts.gstatic.com,images.unsplash.com,images.pexels.com
# Set after Railway gives you a URL, without scheme.
MCP_PUBLIC_HOST=
MAX_BROWSER_SESSIONS=2
ENABLE_INTERACTIONS=false

# GitHub capabilities are optional. The browser tools work without a GitHub token.
# Fine-grained token: Metadata/Contents read, Actions read+write, Workflows only in allowed repos.
GITHUB_TOKEN=
GITHUB_REPOS=YOUR_USERNAME/YOUR_REPO
GITHUB_BRANCH=main
GITHUB_WORKFLOW=handspan-verify.yml
# Off until you deliberately allow agents to change existing source files.
ENABLE_GITHUB_WRITES=false
